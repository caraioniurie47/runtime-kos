<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tour of .NET features on KasperskyOS: threads, async, JSON, regex, GC, and ICU globalization.
       Published and imaged like helloworldapp-kos (see HOWTO-KOS.md). Invariant by default; publish with
       -p:InvariantGlobalization=false to link ICU, otherwise the globalization section reports SKIP. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0: the ILCompiler targets built from main need the ILLink pack of this TFM. -->
    <TargetFramework>net11.0</TargetFramework>
    <!-- Version of the locally built packages in nuget.config's "local" feed. -->
    <KosNetVersion>12.0.0-dev</KosNetVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <StripSymbols>false</StripSymbols>
    <Nullable>enable</Nullable>
    <IlcToolsPath>/home/ilc-tools-main</IlcToolsPath>
    <IlcHostPackagePath>TODO</IlcHostPackagePath>
    <IlcVerboseLogging>false</IlcVerboseLogging>
    <!-- KOS CE SDK 1.4 and later ship clang instead of GCC; SysRoot is <SDK>/sysroot-aarch64-kos. -->
    <CppCompilerAndLinker Condition="'$(CppCompilerAndLinker)' == '' and Exists('$(SysRoot)/../toolchain/bin/aarch64-kos-clang++')">aarch64-kos-clang++</CppCompilerAndLinker>
    <CppCompilerAndLinker Condition="'$(CppCompilerAndLinker)' == ''">aarch64-kos-g++</CppCompilerAndLinker>
    <!-- Culture-aware formatting and sorting need ICU code and data in the binary (about 37 MB). -->
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler; runtime.linux-arm64.Microsoft.DotNet.ILCompiler" Version="$(KosNetVersion)" />
    <!-- The NativeAOT runtime (runtime libraries, framework) ships in this pack. The SDK would pick its own shipped
         version of it, so restore the local one explicitly and point ILC at it below. -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-arm64" Version="[$(KosNetVersion)]" />
  </ItemGroup>

  <PropertyGroup>
    <_KosNativeAotRuntimePack>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.netcore.app.runtime.nativeaot.linux-arm64/$(KosNetVersion)/runtimes/linux-arm64/</_KosNativeAotRuntimePack>
    <IlcFrameworkPath>$(_KosNativeAotRuntimePack)lib/</IlcFrameworkPath>
    <IlcFrameworkNativePath>$(_KosNativeAotRuntimePack)native/</IlcFrameworkNativePath>
    <IlcSdkPath>$(IlcFrameworkNativePath)</IlcSdkPath>
  </PropertyGroup>

</Project>
